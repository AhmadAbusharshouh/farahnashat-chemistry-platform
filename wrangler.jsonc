{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farahnashat-chemistry-worker",
  "main": "worker-entry.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chemistry_platform_d1",
      "database_id": "480690b5-5c8f-4e86-8075-a408546bc47b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "chemistry-assets-r2"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "NEXT_PUBLIC_SCHOOL_NAME": "المدرسة الإسلامية الحديثة - إربد (حكما)",
    "NEXT_PUBLIC_TEACHER_NAME": "أ. فرح نشأت",
    "EVOLUTION_API_URL": "https://wa.alphaperfume.net",
    "EVOLUTION_INSTANCE_NAME": "farah",
    "EVOLUTION_API_KEY": "AlphaSecretKey2026!357951****++"
  }
}
